# Supabase projesi (Settings > API). .env.local dosyasına kopyalayıp doldurun; .env.local commit EDİLMEZ.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Servis rolü anahtarı: yalnız SUNUCUDA kullanılır (RLS'i atlar). Asla NEXT_PUBLIC_ öneki verilmez.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron çağrılarını doğrulamak için uzun rastgele bir değer (ör. openssl rand -hex 32).
CRON_SECRET=
# Mesajlaşma (SMS/WhatsApp/Mail) altyapısı: Asistan Merkezi (mesaj.asistanmerkezi). Tanımlı değilse mesajlar kuyrukta bekler, gönderilmez.
MESAJ_MERKEZ_BASE_URL=
MESAJ_MERKEZ_API_KEY=
